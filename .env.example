# 复制为 .env 并填入真实值;或在 shell 里 export
# 三个变量任一缺失时,config.py 会用默认值(MiniMax-M3)

# 必填:你的 MiniMax 平台 API key
LLM_API_KEY=

# 可选:API endpoint,默认指向 MiniMax
LLM_BASE_URL=https://api.MiniMax.chat/v1

# 可选:模型名
LLM_MODEL=MiniMax-M3

# 可选:每日 token 预算(估算,char/4)。默认 200000(约 2-3 场面试)
# 设为 0 关闭预算检查
LLM_DAILY_TOKEN_CAP=200000

# 可选:历史会话保留天数(从 ended_at 算起)。默认 30 天
# 设为 0 禁用自动清理(慎用,会无限累积)
STORAGE_RETENTION_DAYS=30

# 可选:SQLite 数据库路径(测试隔离用,AppTest 子进程也能用 env 传)
# 留空用默认 data/interviews.db
# STORAGE_DB_PATH=data/interviews.db
